Panels:
- Class: rviz_common/Displays
  Name: Displays
Visualization Manager:
  Class: ''
  Displays:
  - Class: rviz_default_plugins/Grid
    Name: Grid
    Enabled: true
    Cell Size: 0.1
    Plane Cell Count: 20
    Reference Frame: world
    Value: true
  - Class: rviz_default_plugins/RobotModel
    Name: RobotModel
    Enabled: true
    Description Source: Topic
    Description Topic:
      Value: /robot_description
    Value: true
  - Class: rviz_default_plugins/TF
    Name: TF
    Enabled: true
    Marker Scale: 0.15
    Show Names: false
    Frames:
      All Enabled: true
    Value: true
  Global Options:
    Fixed Frame: world
    Frame Rate: 30
  Tools:
  - Class: rviz_default_plugins/Interact
  - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 2.8
      Focal Point:
        X: 0.3
        Y: 0.0
        Z: 0.5
      Pitch: 0.55
      Yaw: 3.9
Window Geometry:
  Width: 1500
  Height: 950
